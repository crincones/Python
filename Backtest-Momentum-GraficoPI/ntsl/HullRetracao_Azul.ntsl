//------------------------------------------------------------------
// HullRetracao_Azul  -  Grafico PI 20 (WINFUT)  -  NTSL
//
// Indicador do candidato medido em hull_contra.html / PLANO_HULL.md:
// com a Hull 50 inclinada, o preco devolve 2 ou 3 candles contra ela, e
// o primeiro candle que volta a favor da Hull -- fechando sem rejeicao --
// e o sinal.
//
//   ▲ azul abaixo da minima  = COMPRA
//   ▼ azul acima da maxima   = VENDA
//
// Azul para nao confundir com o MomentumPI_OuroPrata (ambar/prata), o
// PavioContra_Magenta e o PavioFavor_Verde.
// Inserir no MESMO painel do grafico de precos.
//
//==================================================================
// A REGRA  (compra; venda e o espelho exato)
//==================================================================
// Lida na barra do SINAL, a atual, depois que ela FECHA:
//
//   1. Hull 50 SUBINDO:        Hull > Hull[1]
//   2. a barra atual fecha em ALTA
//   3. imediatamente antes dela, 2 ou 3 barras seguidas fecharam em
//      BAIXA, no mesmo pregao -- 1 ou 4+ nao vale
//   4. pavio do lado do FECHAMENTO pequeno: na compra, o pavio de CIMA
//
//          High - Close  <=  10% do corpo     (no PI 20: ate 10 pts)
//
//      Na venda, o de BAIXO: Close - Low. O pavio do lado da abertura
//      NAO entra.
//
// A entrada medida e a mercado no fechamento dessa barra. Gestao (fora
// deste indicador): stop 100, parcial de 50% em +100 com o stop do
// restante na media da operacao, alvo 300, zerando no fim do pregao,
// uma posicao por vez. Ver PLANO_HULL.md.
//
//==================================================================
// O QUE FOI MEDIDO  (WINFUT_20PI.csv, 10.000 barras, 26 pregoes)
//==================================================================
// Bruto, entrada no fechamento, 1:3 com parcial:
//
//   Hull a favor, 2-4 barras (so a Hull)       922 sinais   +11,4 pts
//   Hull contra, 2-4 barras                   1228 sinais    +1,7 pts
//   ESTE INDICADOR (Hull + 2-3 + fech <=10%)   707 sinais   +16,7 pts
//     tercos +21,7 / +11,6 / +18,1   compra +21,8   venda +11,4
//
// Carteira, uma posicao por vez: 669 operacoes, +11.800 pts, fator de
// lucro 1,40, acerto 30,8%, rebaixamento maximo 1.400 pts (Monte Carlo
// p95: 2.500). A 10 pts de custo por operacao: cerca de +6,7 por sinal.
//
// RESSALVAS: 26 pregoes, todos em mercado de alta. A Hull a favor era
// hipotese definida antes de medir; os cortes 2-3 barras e fech <=10%
// foram escolhidos nesta mesma amostra -- os numeros sao um teto. Rode
// em simulador antes de dinheiro real.
//
//==================================================================
// HULL: A DO GRAFICO TEM DE SER A MESMA
//==================================================================
// HullMovingAverage(50) sobre o fechamento, na serie inteira (atravessa
// os dias). O backteste calcula WMA(2*WMA(25) - WMA(50), 7). Para
// conferir, ligue Diagnostico(1): o numero amarelo embaixo de cada barra
// e a Hull que o indicador esta usando -- compare com a HMA 50 do grafico.
//
// Hull 34 mediu parecido com 50; 21 e 80 mediram pior.
//
//==================================================================
// REPINTURA
//==================================================================
// Enquanto a barra nao fecha, o lado dela, o pavio e a propria Hull
// mudam: a seta pode aparecer e sumir. Em barra fechada ela e
// definitiva. Opere so a seta de barra FECHADA.
//
// Licoes herdadas do MomentumPI_OuroPrata (ver secao 5 dele):
//   . Date e funcao sem parametros: capturada em `dataBarra` e o
//     historico e lido da variavel, nunca como Date[j].
//   . PlotText so usa o parametro Price com Position = 3.
//------------------------------------------------------------------

input
  PeriodoHull     (50);
  BarrasMin       (2);     // barras contra a Hull antes do sinal
  BarrasMax       (3);
  PavioFechMaxPct (10);    // pavio do lado do FECHAMENTO, em % do CORPO
  OperarCompra    (1);
  OperarVenda     (1);
  TamSeta         (12);
  SeparacaoPts    (40);    // afastamento da seta, em pontos do ativo
  Colorir         (1);     // 1 = pinta a barra do sinal de azul
  ChecarDia       (1);     // 1 = sequencia inteira no mesmo pregao
  Diagnostico     (0);     // 1 = escreve a Hull usada embaixo de cada barra

var
  j, k                 : integer;
  dataBarra            : float;
  hull0, hull1         : float;
  pavio, corpo         : float;
  compra, venda        : boolean;
  contando             : boolean;
  azul                 : integer;

begin
  dataBarra := Date;
  azul      := RGB(0, 150, 255);

  hull0 := HullMovingAverage(PeriodoHull);
  hull1 := HullMovingAverage(PeriodoHull)[1];

  if CurrentBar >= PeriodoHull + BarrasMax + 10 then
  begin
    //--- 1 e 2: Hull no sentido do trade e barra fechando a favor dela --
    compra := (OperarCompra = 1) and (hull0 > hull1) and (Close > Open);
    venda  := (OperarVenda = 1)  and (hull0 < hull1) and (Close < Open);

    if compra or venda then
    begin
      //--- 3: barras CONTRA a Hull, seguidas, terminando em [1] ---------
      k := 0;
      contando := true;
      for j := 1 to BarrasMax + 1 do
      begin
        if contando then
        begin
          if (ChecarDia = 1) and (dataBarra[j] <> dataBarra) then
            contando := false
          else if compra and (Close[j] < Open[j]) then
            k := j
          else if venda and (Close[j] > Open[j]) then
            k := j
          else
            contando := false;
        end;
      end;

      //--- 4: pavio do lado do fechamento --------------------------------
      if compra then
        pavio := High - Close     // barra de alta: fechamento em cima
      else
        pavio := Close - Low;     // barra de baixa: fechamento embaixo

      corpo := Close - Open;
      if corpo < 0 then corpo := -corpo;

      //--- desenho ------------------------------------------------------
      //  comparacao por multiplicacao: sem divisao, sem risco de zero
      if (k >= BarrasMin) and (k <= BarrasMax)
         and (pavio * 100 <= PavioFechMaxPct * corpo) then
      begin
        if compra then
          PlotText("▲", azul, 3, TamSeta, Low - SeparacaoPts)
        else
          PlotText("▼", azul, 3, TamSeta, High + SeparacaoPts);

        if Colorir = 1 then
          PaintBar(azul);
      end;
    end;

    if Diagnostico = 1 then
      PlotText("h" + Round(hull0), RGB(255, 190, 0), 3, TamSeta,
               Low - SeparacaoPts * 2);
  end;
end;
